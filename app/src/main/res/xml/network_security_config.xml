<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local phone testing uses the laptop LAN address, which can change.
         The app manifest explicitly opts into clear-text traffic for this dev build. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
