# Server-only configuration. Never prefix keys with VITE_ or commit real values.
# Set only a provider already approved for this children's learning app.
# The 797 provider key can be reused as a server secret; no private 797 routes are exposed.
ARCHIE_CLOUD_PROVIDER=none
# OPENAI_API_KEY=
# ARCHIE_MODEL=
# OPENAI_ECONOMY_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Optional Ollama running on a trusted network reachable by this server:
# ARCHIE_OLLAMA_URL=http://127.0.0.1:11434
# LOCAL_AI_MODEL=
# Do not set VITE_API_BASE_URL for the separate web test: it uses its own server.
